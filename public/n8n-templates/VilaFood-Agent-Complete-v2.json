        "options": {
          "systemMessage": "Você é o assistente virtual da loja. Seja cordial e objetivo. Responda APENAS sobre produtos e pedidos. Use emojis moderadamente. Preços sempre em R$."
        }
      },
      "id": "10",
      "name": "AI Brain Gemini",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [1760, 300]
