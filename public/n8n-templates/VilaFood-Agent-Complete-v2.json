      "name": "É Última Mensagem?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, 300]
    },
    {
      "parameters": {
        "jsCode": "const messages = $json.messages || [];\nconst parsedMessages = messages.map(m => {\n  try { return JSON.parse(m); } catch { return { content: m, timestamp: Date.now() }; }\n});\nconst sorted = parsedMessages.sort((a, b) => a.timestamp - b.timestamp);\nconst combined = sorted.map(m => m.content).join('\\n');\nconst originalData = $('Extrai Campos').first().json;\n\nreturn { ...originalData, content: combined, messageCount: messages.length };"
      },
      "id": "14",
      "name": "Combina Mensagens Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 200]
