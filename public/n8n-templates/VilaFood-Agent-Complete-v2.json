              "name": "final_message",
              "value": "={{ $('Transcreve Audio').item?.json?.text || $('Analisa Imagem').item?.json?.extracted_data?.description || $('Extrai Campos').item.json.message_text }}"
            },
            {
              "name": "phone",
              "value": "={{ $('Extrai Campos').item.json.phone }}"
            },
            {
              "name": "instance_name",
              "value": "={{ $('Extrai Campos').item.json.instance_name }}"
