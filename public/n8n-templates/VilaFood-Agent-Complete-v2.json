            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audio_url: $('Extrai Campos').item.json.audio_url, mime_type: 'audio/ogg' }) }}",
        "options": {}
      },
      "id": "6",
      "name": "Transcreve Audio",
      "type": "n8n-nodes-base.httpRequest",
