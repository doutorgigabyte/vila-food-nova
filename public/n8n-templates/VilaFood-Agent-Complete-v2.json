{
  "name": "VilaFood-Agent-Complete-v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vilafood-webhook",
        "responseMode": "lastNode"
      },
      "id": "1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "vilafood-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.data?.key?.fromMe }}",
              "value2": true,
              "operation": "notEqual"
            }
          ]
        }
      },
      "id": "2",
      "name": "Ignora mensagens proprias",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "instance_name", "value": "={{ $json.instance }}" },
            { "name": "phone", "value": "={{ $json.data?.key?.remoteJid?.replace('@s.whatsapp.net', '') }}" },
            { "name": "message_text", "value": "={{ $json.data?.message?.conversation || $json.data?.message?.extendedTextMessage?.text || '' }}" },
            { "name": "message_type", "value": "={{ $json.data?.message?.audioMessage ? 'audio' : $json.data?.message?.imageMessage ? 'image' : 'text' }}" },
            { "name": "audio_url", "value": "={{ $json.data?.message?.audioMessage?.url || '' }}" },
            { "name": "image_url", "value": "={{ $json.data?.message?.imageMessage?.url || '' }}" }
          ],
          "number": [
            { "name": "timestamp", "value": "={{ Date.now() }}" }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Extrai Campos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/get_establishment_by_instance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "p_instance_name", "value": "={{ $json.instance_name }}" }
          ]
        },
        "options": {}
      },
      "id": "4",
