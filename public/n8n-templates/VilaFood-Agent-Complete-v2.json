    },
    {
      "parameters": {
        "jsCode": "const response = $json.output || $json.text || '';\nconst maxLength = 400;\n\nif (response.length <= maxLength) {\n  return [{ message: response, index: 0 }];\n}\n\nconst chunks = [];\nlet current = '';\nconst words = response.split(' ');\n\nfor (const word of words) {\n  if ((current + ' ' + word).length > maxLength) {\n    if (current) chunks.push(current.trim());\n    current = word;\n  } else {\n    current += (current ? ' ' : '') + word;\n  }\n}\nif (current) chunks.push(current.trim());\n\nreturn chunks.map((msg, idx) => ({ message: msg, index: idx }));"
      },
