      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message_type }}",
              "value2": "audio",
              "operation": "equal"
            }
          ]
        }
      },
      "id": "5",
      "name": "E Audio",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [880, 300]
