    {
      "parameters": {
        "toolDescription": "Busca produtos no cardápio pelo nome ou categoria",
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/products",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "establishment_id", "value": "eq.{{ $json.establishment.id }}" },
            { "name": "is_active", "value": "eq.true" },
            { "name": "name", "value": "ilike.*{{ $fromAI('search_term') }}*" },
            { "name": "select", "value": "id,name,price,promotional_price,description,image_url" },
            { "name": "limit", "value": "5" }
          ]
        }
      },
      "id": "tool-search-menu",
      "name": "Tool: search_menu",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [2640, 800]
    },
    {
      "parameters": {
        "jsCode": "// Split long messages into chunks\nconst response = $input.first().json.response;\nconst MAX_CHARS = 400;\nconst messages = [];\n\nif (response.length <= MAX_CHARS) {\n  return [{ json: { message: response, index: 0, total: 1 } }];\n}\n\nconst paragraphs = response.split('\\n\\n');\nlet currentChunk = '';\n\nfor (const p of paragraphs) {\n  if ((currentChunk + '\\n\\n' + p).length > MAX_CHARS && currentChunk) {\n    messages.push(currentChunk.trim());\n    currentChunk = p;\n  } else {\n    currentChunk = currentChunk ? currentChunk + '\\n\\n' + p : p;\n  }\n}\nif (currentChunk) messages.push(currentChunk.trim());\n\nreturn messages.map((msg, i) => ({ json: { message: msg, index: i, total: messages.length } }));"
      },
      "id": "split-messages",
      "name": "Split Mensagens Longas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 0]
