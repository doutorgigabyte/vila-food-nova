        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/functions/v1/geocode-and-calculate-delivery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"establishment_id\": \"{{ $('Busca Estabelecimento').item.json.id }}\", \"customer_address\": \"{customer_address}\"}"
      },
