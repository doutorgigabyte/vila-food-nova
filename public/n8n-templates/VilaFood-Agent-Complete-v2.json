      "position": [1540, 100]
    },
    {
      "parameters": {
        "jsCode": "const analysis = $json.analysis || 'Não foi possível analisar a imagem';\nconst originalData = $('Extrai Campos').first().json;\n\nreturn {\n  ...originalData,\n  content: `[Cliente enviou uma imagem]\\nAnálise: ${analysis}`,\n  messageType: 'image_analyzed'\n};"
      },
