    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/get_establishment_by_whatsapp_instance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_instance_name\": \"{{ $json.instance }}\"\n}"
      },
      "id": "3",
      "name": "Busca Estabelecimento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extrai campos importantes da mensagem\nconst item = $input.first().json;\nconst message = item.data?.message || {};\nconst key = item.data?.key || {};\n\nconst phone = key.remoteJid?.replace('@s.whatsapp.net', '') || '';\nconst instanceName = item.instance || '';\nconst pushName = item.data?.pushName || 'Cliente';\nconst establishment = $('Busca Estabelecimento').first().json;\n\n// Detecta tipo de mensagem\nlet messageType = 'text';\nlet content = '';\nlet mediaKey = null;\n\nif (message.conversation) {\n  messageType = 'text';\n  content = message.conversation;\n} else if (message.extendedTextMessage?.text) {\n  messageType = 'text';\n  content = message.extendedTextMessage.text;\n} else if (message.imageMessage) {\n  messageType = 'image';\n  mediaKey = message.imageMessage.mediaKey;\n  content = message.imageMessage.caption || '[Imagem]';\n} else if (message.audioMessage) {\n  messageType = 'audio';\n  mediaKey = message.audioMessage.mediaKey;\n  content = '[Áudio]';\n} else if (message.videoMessage) {\n  messageType = 'video';\n  mediaKey = message.videoMessage.mediaKey;\n  content = message.videoMessage.caption || '[Vídeo]';\n}\n\nreturn {\n  phone,\n  instanceName,\n  pushName,\n  messageType,\n  content,\n  mediaKey,\n  messageId: key.id,\n  timestamp: Date.now(),\n  establishment\n};"
      },
      "id": "4",
      "name": "Extrai Campos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.messageType }}", "rightValue": "image", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputKey": "image"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.messageType }}", "rightValue": "audio", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputKey": "audio"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "leftValue": "={{ $json.messageType }}", "rightValue": "text", "operator": { "type": "string", "operation": "equals" } }]
