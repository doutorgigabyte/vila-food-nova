      "parameters": {
        "amount": 3
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [240, 0],
      "id": "debounce-wait",
      "name": "Debounce Wait (3s)",
      "webhookId": "debounce-webhook"
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "messages",
        "key": "=vilafood:msgs:{{ $('Extract Message Fields').item.json.session_key }}",
        "options": {}
      },
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [480, 0],
      "id": "redis-get",
      "name": "Redis Get Messages",
      "credentials": {
        "redis": {
          "id": "redis-account",
          "name": "Redis Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine all messages from debounce buffer\nconst messages = $input.first().json.messages || [];\n\n// Handle different message formats (array or string)\nlet combinedText = '';\nif (Array.isArray(messages)) {\n  combinedText = messages.filter(m => m && m.trim()).join(' ').trim();\n} else if (typeof messages === 'string') {\n  combinedText = messages.trim();\n}\n\n// Get context from previous nodes\nconst extractedFields = $('Extract Message Fields').first().json;\nconst establishment = $('Get Establishment Config').first().json;\nconst cartSession = $('Get Cart & Session').first().json;\n\nreturn {\n  text: combinedText || extractedFields.message_text,\n  session_key: extractedFields.session_key,\n  instance_name: extractedFields.instance_name,\n  remote_jid: extractedFields.remote_jid,\n  phone: extractedFields.phone,\n  push_name: extractedFields.push_name,\n  establishment: Array.isArray(establishment) ? establishment[0] : establishment,\n  cart: cartSession?.cart || [],\n  cart_total: cartSession?.total || 0,\n  customer: cartSession?.customer || null\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0],
      "id": "combine-messages",
      "name": "Combine Messages"
    },
    {
      "parameters": {
        "operation": "delete",
        "key": "=vilafood:msgs:{{ $('Extract Message Fields').item.json.session_key }}"
      },
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [960, 0],
      "id": "redis-clear",
      "name": "Redis Clear Messages",
      "credentials": {
        "redis": {
          "id": "redis-account",
          "name": "Redis Account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Combine Messages').item.json.text }}",
        "options": {
          "systemMessage": "={{ $('Combine Messages').item.json.establishment?.system_prompt || 'Você é um assistente de atendimento de delivery. Ajude o cliente a fazer pedidos.' }}\n\n---\n\n### Cardápio Disponível\n\n{{ JSON.stringify($('Combine Messages').item.json.establishment?.menu_json || []) }}\n\n---\n\n### Dados do Cliente\n\nNome: {{ $('Combine Messages').item.json.customer?.name || $('Combine Messages').item.json.push_name || 'Não informado' }}\nTelefone: {{ $('Combine Messages').item.json.phone }}\nEndereço: {{ $('Combine Messages').item.json.customer?.default_address?.street || 'Não informado' }}\n\n---\n\n### Carrinho Atual\n\n{{ JSON.stringify($('Combine Messages').item.json.cart || []) }}\nTotal: R$ {{ $('Combine Messages').item.json.cart_total || '0,00' }}\n\n---\n\n### Contexto\n\n- Data e Hora: {{ $now.format('dd/MM/yyyy HH:mm') }}\n- Dia da Semana: {{ $today.weekdayLong }}\n- Estabelecimento: {{ $('Combine Messages').item.json.establishment?.name || 'VilaFood' }}\n- Aceita Delivery: {{ $('Combine Messages').item.json.establishment?.accepts_delivery ? 'Sim' : 'Não' }}\n- Aceita Retirada: {{ $('Combine Messages').item.json.establishment?.accepts_pickup ? 'Sim' : 'Não' }}\n- Pedido Mínimo: R$ {{ $('Combine Messages').item.json.establishment?.min_order_value || '0,00' }}\n\n---\n\n### Instruções Importantes\n\n1. Seja cordial e objetivo\n2. Sempre confirme os itens antes de adicionar ao carrinho\n3. Use emojis moderadamente para tornar a conversa agradável\n4. Quando o cliente quiser finalizar, pergunte se é delivery ou retirada\n5. Para delivery, peça o endereço completo\n6. Informe o valor total incluindo taxa de entrega quando aplicável\n7. Ao gerar pedido, envie o QR Code PIX para pagamento"
        }
      },
