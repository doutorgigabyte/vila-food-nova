# ============================================================================
# VilaFood — Supabase Edge Functions Secrets
# ============================================================================
# Configure via Supabase Dashboard > Project Settings > Edge Functions > Secrets
# ou via CLI: supabase secrets set NOME="valor"
#
# NÃO copie este arquivo como .env real — ele é apenas documentação.
# Os valores reais devem viver SOMENTE no Supabase secrets, nunca commitados.

# ============================================================================
# CORE — Supabase (auto-injetadas pela plataforma, NÃO precisa setar)
# ============================================================================
# SUPABASE_URL              — disponível automaticamente em edge functions
# SUPABASE_ANON_KEY         — disponível automaticamente
# SUPABASE_SERVICE_ROLE_KEY — disponível automaticamente

# ============================================================================
# AMBIENTE
# ============================================================================
ENVIRONMENT="production"          # "production" | "staging" | "development"
APP_DOMAIN="vilafood.delivery"    # usado em product-feeds e URLs canônicas

# ============================================================================
# MERCADO PAGO (OBRIGATÓRIO se aceitar pagamentos via MP)
# ============================================================================
MERCADOPAGO_ACCESS_TOKEN=""         # Token de produção (APP_USR-...)
MERCADOPAGO_CLIENT_ID=""            # OAuth client ID
MERCADOPAGO_CLIENT_SECRET=""        # OAuth client secret
MERCADOPAGO_REDIRECT_URI=""         # ex: https://vilafood.delivery/oauth/mercadopago/callback
MERCADOPAGO_WEBHOOK_SECRET=""       # Assinatura HMAC do webhook (Painel MP)
MERCADOPAGO_PLATFORM_FEE="5"        # Taxa em % cobrada pela plataforma no split

# ============================================================================
# PAGBANK / PAGSEGURO (OBRIGATÓRIO se aceitar pagamentos via PagBank)
# ============================================================================
PAGSEGURO_CLIENT_ID=""
PAGSEGURO_CLIENT_SECRET=""
PAGSEGURO_PUBLIC_KEY=""             # Mesma do VITE_PAGSEGURO_PUBLIC_KEY (validação backend)
PAGSEGURO_REDIRECT_URI=""           # ex: https://vilafood.delivery/oauth/pagseguro/callback
PAGSEGURO_ENVIRONMENT="production"  # "sandbox" | "production"
PAGSEGURO_PLATFORM_ACCOUNT_ID=""    # Conta da plataforma para split
PAGSEGURO_WEBHOOK_SECRET=""         # Token usado para validar x-authenticity-token nos webhooks

# ============================================================================
# IA — Google Gemini / Lovable AI (OBRIGATÓRIO para features de IA)
# ============================================================================
GOOGLE_API_KEY=""                   # Gemini + Imagen (geração de descrições/fotos)
LOVABLE_API_KEY=""                  # Lovable AI Gateway (agente WhatsApp + recomendações)

# ============================================================================
# WHATSAPP — Evolution API (OBRIGATÓRIO para módulo WhatsApp)
# ============================================================================
# Self-hosted via Coolify (migração 2026-05-09). Antes era press.vilafood.delivery.
EVOLUTION_API_URL="https://evo.vilafood.delivery"
EVOLUTION_API_KEY=""

# Nome da instância WhatsApp da plataforma usada como fallback quando o
# estabelecimento não tem instância própria configurada. NUNCA use sua conta
# pessoal — crie uma instância dedicada do tipo "vilafood-platform".
PLATFORM_WHATSAPP_INSTANCE=""

# ============================================================================
# AWS S3 + CloudFront (OBRIGATÓRIO para uploads de imagens)
# ============================================================================
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="sa-east-1"
AWS_CLOUDFRONT_URL=""               # ex: https://d2fhl3f70zfvod.cloudfront.net

# ============================================================================
# iFood — Integração de catálogo (OPCIONAL)
# ============================================================================
IFOOD_CLIENT_ID=""
IFOOD_CLIENT_SECRET=""

# ============================================================================
# Resend — Envio transacional de e-mail (OBRIGATÓRIO para recovery password)
# ============================================================================
RESEND_API_KEY=""

# ============================================================================
# LocalizAI — Sync bidirecional com sistema externo (OPCIONAL)
# ============================================================================
LOCALIZA_SUPABASE_URL=""
LOCALIZA_SUPABASE_SERVICE_KEY=""

# ============================================================================
# Partner Sync (OPCIONAL — integração com Rota)
# ============================================================================
PARTNER_SYNC_SECRET=""              # Bearer token validado em partner-sync-from-rota
