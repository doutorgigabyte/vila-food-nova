# ============================================================================
# VilaFood — Frontend Environment Variables (Vite)
# ============================================================================
# Variáveis prefixadas com VITE_* são embutidas no bundle do navegador.
# NUNCA coloque secrets de backend aqui (use Supabase Functions secrets).
# Copie este arquivo para .env (não commitar) e preencha os valores.

# ----------------------------------------------------------------------------
# Supabase (OBRIGATÓRIO)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# ----------------------------------------------------------------------------
# Google Maps API Key (OPCIONAL — mapas e autocomplete de endereço)
# ----------------------------------------------------------------------------
# Restrinja a chave por HTTP referrer (vilafood.delivery/*) no Google Cloud Console.
# Habilite APIs: Maps JavaScript API, Places API, Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=""

# ----------------------------------------------------------------------------
# PagBank/PagSeguro (OBRIGATÓRIO se aceitar cartão via PagBank)
# ----------------------------------------------------------------------------
# Chave pública do SDK PagBank (não é secret).
VITE_PAGSEGURO_PUBLIC_KEY=""

# ----------------------------------------------------------------------------
# Sentry — Observabilidade (OPCIONAL mas recomendado em produção)
# ----------------------------------------------------------------------------
VITE_SENTRY_DSN=""
VITE_RELEASE_SHA=""

# ----------------------------------------------------------------------------
# Analytics platform-level (OPCIONAL)
# ----------------------------------------------------------------------------
# Usados em src/lib/landingAnalytics.ts para tracking da landing institucional
# (/conheca, /, etc). Diferente das tabelas analytics_pixels (que são por
# estabelecimento). Só dispara após o usuário aceitar consent.level === "all"
# no CookieConsentBanner (LGPD compliance).
VITE_GA_MEASUREMENT_ID=""
VITE_FACEBOOK_PIXEL_ID=""

# ----------------------------------------------------------------------------
# Ambiente
# ----------------------------------------------------------------------------
# Valores: "production" | "staging" | "development"
VITE_ENVIRONMENT="development"

# ----------------------------------------------------------------------------
# Daré API Gateway (Smart Guide / Tamandaré)
# ----------------------------------------------------------------------------
# Integração com a IA da Daré (chat conversacional, geração de roteiros,
# clima/maré, horários de ônibus). Edge functions Deno hosteadas no Coolify
# do Smart Guide. Detalhes em docs/DARE-API-INTEGRATION.md.
#
# Quando o domínio fixo for definido (ex: api.tamandare.app), trocar a URL.
VITE_DARE_API_BASE_URL="http://z11ayq15whm8wmr51j3cv2bp.185.100.215.206.sslip.io/functions/v1"

# Anon key do SUPABASE DO SMART GUIDE (não confundir com a do Vila Food).
# Pegar no Coolify: supabase-bm30vj8tm3qze7pgi61ogai3 > Environment > ANON_KEY.
VITE_DARE_ANON_KEY=""

# Feature flag pra ativar o widget de chat do Daré no Vila Food.
# Default "false" — só liga quando integração estiver testada em staging.
VITE_DARE_ENABLED="false"

# ----------------------------------------------------------------------------
# API Gateway centralizado (Doutor Gigabyte) — OPCIONAL
# ----------------------------------------------------------------------------
# Quando configurado como SECRETS DO SUPABASE (não como VITE_*), as edge
# functions abaixo passam a rotear pelo gateway. Sem isso, o código continua
# usando os providers diretos (Lovable AI, Resend, Google Maps). Em qualquer
# falha do gateway, fallback automático para o caminho legacy.
#
# Cadastrar no Supabase Dashboard > Settings > Edge Functions > Secrets:
#   GATEWAY_API_URL=https://api.seuservidor.com
#   GATEWAY_API_TOKEN=giga_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Funções já migradas:
#   - geocode-and-calculate-delivery  -> maps/geocode
#   - send-password-reset             -> email/send
#   - ai-recommendations              -> llm/chat
#   - ai-product-assistant            -> llm/chat
#   - analyze-establishment           -> llm/chat
#   - extract-customer-data           -> llm/chat
#   - analyze-image                   -> llm/chat (vision multimodal)
#   - transcribe-audio                -> llm/chat (audio multimodal)
#   - whatsapp-ai-response            -> llm/chat (com tool calling)
#   - ai-health-check                 -> llm/chat (probe)
#
# NÃO migrado (multi-tenant ou sem provider no gateway):
#   - mercadopago-* / pagseguro-* / auto-refund (multi-tenant + split + HMAC)
#   - whatsapp-* / evolution-api (multi-tenant per-establishment)
#   - s3-* / ifood-* (sem provider no gateway)
#   - generate-image (usa Pollinations.ai gratuito)
#
# Detalhes: docs/API_GATEWAY_INTEGRATION.md
